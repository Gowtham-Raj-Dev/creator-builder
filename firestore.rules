rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── helpers ──────────────────────────────────────────────────────────────
    function signedIn() { return request.auth != null && request.auth.token.email != null; }
    function email() { return signedIn() ? request.auth.token.email.lower() : ""; }
    // Platform owner(s): keep in sync with src/lib/auth/config.ts
    function isPlatformOwner() { return signedIn() && email() in ['gowthamraje1221@gmail.com']; }
    function isAppOwner(app) { return isPlatformOwner() || (signedIn() && app.get('ownerEmail', null) != null && app.ownerEmail.lower() == email()); }
    // Per-app builder collaborators (app.builderEmails): may edit the app definition, but not ownership or the collaborator list
    function isBuilder(app) { return signedIn() && app.get('builderEmails', null) != null && email() in app.builderEmails; }
    function canBuild(app) { return isAppOwner(app) || isBuilder(app); }
    function keepsOwnership() {
      return request.resource.data.get('ownerEmail', null) == resource.data.get('ownerEmail', null)
        && request.resource.data.get('builderEmails', []) == resource.data.get('builderEmails', [])
        && request.resource.data.get('builders', []) == resource.data.get('builders', []);
    }
    function isMember(app) { return signedIn() && app.get('memberEmails', null) != null && email() in app.memberEmails; }
    function isPublic(app) { return app.sharing != null && app.sharing.mode == 'public_view'; }
    function appDoc(appId) { return get(/databases/$(database)/documents/apps/$(appId)).data; }

    // ── apps ─────────────────────────────────────────────────────────────────
    match /apps/{appId} {
      allow read: if canBuild(resource.data) || isMember(resource.data) || isPublic(resource.data);
      allow create: if isPlatformOwner();
      allow update: if isAppOwner(resource.data) || (isBuilder(resource.data) && keepsOwnership());
      allow delete: if isAppOwner(resource.data);

      match /records/{recordId} {
        allow read: if canBuild(appDoc(appId)) || isMember(appDoc(appId)) || isPublic(appDoc(appId));
        allow create, update, delete: if canBuild(appDoc(appId)) || isMember(appDoc(appId));
      }
      match /versions/{versionId} {
        allow read: if canBuild(appDoc(appId)) || isMember(appDoc(appId)) || isPublic(appDoc(appId));
        allow write: if canBuild(appDoc(appId));
      }
      match /audit/{entryId} {
        allow read: if canBuild(appDoc(appId));
        allow create: if canBuild(appDoc(appId)) || isMember(appDoc(appId));
      }
      match /workflowLogs/{entryId} {
        allow read: if canBuild(appDoc(appId));
        allow create: if canBuild(appDoc(appId)) || isMember(appDoc(appId));
      }
      match /comments/{commentId} {
        allow read, create: if canBuild(appDoc(appId)) || isMember(appDoc(appId));
        allow delete: if canBuild(appDoc(appId));
      }
    }

    // ── platform collections ─────────────────────────────────────────────────
    match /users/{userEmail} {
      allow read, write: if isPlatformOwner() || (signedIn() && userEmail == email());
    }
    match /templates/{templateId} {
      allow read: if signedIn();
      allow write: if isPlatformOwner();
    }
    match /notifications/{id} {
      allow read, update: if signedIn() && resource.data.toEmail == email();
      allow create: if signedIn();
    }
    // Firebase "Trigger Email" extension reads this collection
    match /mail/{id} {
      allow create: if signedIn();
    }
    match /platform/{doc} {
      allow read, write: if isPlatformOwner();
      // builder collaborators may read/write an app's own AI keys (platform/ai_<appId>), never the global platform/settings
      allow read, write: if doc.matches('ai_.*') && isBuilder(appDoc(doc.replace('ai_', '')));
      // members may read an app's own AI keys only when the owner switched on "Allow members to use AI" for that app
      allow read: if doc.matches('ai_.*') && signedIn()
        && isMember(appDoc(doc.replace('ai_', '')))
        && appDoc(doc.replace('ai_', '')).settings != null
        && appDoc(doc.replace('ai_', '')).settings.allowMembersAi == true;
    }
  }
}
