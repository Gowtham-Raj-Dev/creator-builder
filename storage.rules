rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Uploads are namespaced per app: apps/{appId}/uploads/{file}
    match /apps/{appId}/uploads/{fileName} {
      allow read: if true;                       // download URLs are unguessable; tighten if needed
      allow write: if request.auth != null       // any signed-in (configured) user
                   && request.resource.size < 25 * 1024 * 1024;
    }
  }
}
